      "minimum_unique_event_symbols_hit": 8,
      "symbol_cluster_rate_ratio_ci_low_must_exceed": 1.0,
      "validation_and_sealed_must_have_positive_direction": true,
      "minimum_positive_duration_bands_with_at_least_five_events": 2
